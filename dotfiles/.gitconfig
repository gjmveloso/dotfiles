[column]
        ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[init]
        defaultBranch = main
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[push]
        default = simple
        autoSetupRemote = true
        followTags = true
[fetch]
        prune = true
        pruneTags = true
        all = true

[user]
	email = gjmveloso@users.noreply.github.com
	name = Gustavo Veloso
[core]
	editor = zed --wait
[init]
	defaultBranch = main
[includeif "gitdir:~/Code/Internal/**"]
    path = ~/Code/Internal/.gitconfig
